# ======================================================
# VeriSure Ad Automation
# Environment Configuration
# ======================================================

# ------------------------------------------------------
# Application
# ------------------------------------------------------
APP_NAME=VeriSure-Ad-Automation
APP_ENV=development
DEBUG=True
API_VERSION=v1

# ------------------------------------------------------
# Database
# ------------------------------------------------------
DATABASE_URL=

# Dedicated database for the pytest suite only (see README.md "Testing").
# Must differ from DATABASE_URL and its database name must contain "test".
TEST_DATABASE_URL=

# ------------------------------------------------------
# Security
# ------------------------------------------------------
# Preferred settings field name (docker-compose also maps SECRET_KEY).
# Must be at least 32 characters. Insecure defaults (secret, changeme,
# password, dev, dev-only-change-me) are rejected when APP_ENV=production.
JWT_SECRET_KEY=
SECRET_KEY=

# Comma-separated Fernet keys for encrypting stored provider credentials
# (see app/core/security/credential_encryption.py). Each must be a
# urlsafe-base64-encoded 32-byte key, e.g. the output of
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# The first key encrypts; every key in the list can decrypt (rotation
# readiness). Required at API/worker startup. Never commit a real value here.
ENCRYPTION_KEY=

# ======================================================
# AI Providers
# ======================================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ======================================================
# Meta (Facebook / Instagram)
# ======================================================

META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=

# ======================================================
# Google Ads
# ======================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CUSTOMER_ID=

# ======================================================
# LinkedIn Ads
# ======================================================

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=

# ======================================================
# Microsoft Advertising (Bing Ads)
# ======================================================

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_DEVELOPER_TOKEN=
MICROSOFT_REFRESH_TOKEN=
MICROSOFT_CUSTOMER_ID=

# ======================================================
# TikTok Ads
# ======================================================

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ======================================================
# Amazon Ads
# ======================================================

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_PROFILE_ID=

# ======================================================
# Pinterest Ads
# ======================================================

PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_ID=

# ======================================================
# Snapchat Ads
# ======================================================

SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_ACCESS_TOKEN=
SNAP_ORGANIZATION_ID=

# ======================================================
# Reddit Ads
# ======================================================

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
REDDIT_AD_ACCOUNT_ID=

# ======================================================
# X (Twitter) Ads
# ======================================================

X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_AD_ACCOUNT_ID=

# ======================================================
# CRM Webhooks (Future)
# ======================================================

DEFAULT_WEBHOOK_SECRET=

# ======================================================
# Logging
# ======================================================

LOG_LEVEL=INFO

# ======================================================
# Dry Run Mode
# Safety: Prevent accidental live ad deployment
# ======================================================

DRY_RUN=True